# Backend Environment Variables

# Supabase Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=documents

# OpenAI Settings
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7

# JWT Secret (for development/testing only - used by verify_scenario.py)
# Only needed for local testing and CI/CD test runs
# Production environments do NOT need this (backend verifies JWTs using Supabase JWKS)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Security Settings
# Force HTTPS (set to true when deployed behind a proxy like Render)
FORCE_HTTPS=false

# Development Mode - Disable Authentication (NEVER use in production!)
# Set to true to bypass authentication checks during local development
# For Production (Render): MUST set DISABLE_AUTH=false
DISABLE_AUTH=true

# Metrics
METRICS_SERVER_ENABLED=true

# CORS Settings (optional, defaults are set in config.py)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Observability Thresholds (optional, defaults are set in config.py)
# INGESTION_DURATION_THRESHOLD_SECONDS=60.0
# CHAT_LATENCY_THRESHOLD_SECONDS=10.0
