# Backend Environment Variables

# Supabase Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI Settings
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7

# JWT Secret (for local testing and verify_scenario.py)
# In production, this should match your Supabase JWT secret
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Metrics
METRICS_SERVER_ENABLED=true

# CORS Settings (optional, defaults are set in config.py)
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Observability Thresholds (optional, defaults are set in config.py)
# INGESTION_DURATION_THRESHOLD_SECONDS=60.0
# CHAT_LATENCY_THRESHOLD_SECONDS=10.0
